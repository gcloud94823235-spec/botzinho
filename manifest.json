{
  "manifest_version": 3,
  "name": "Lumena Autoplay Farm Local",
  "version": "7.7.2",
  "description": "Farm local, batalha, captura, treinadores, diagnóstico e Auto Spin opcional do Volt Casino.",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://lumena.gg/*",
    "https://*.lumena.gg/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lumena Autoplay Farm Local v7.7.2"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lumena.gg/*",
        "https://*.lumena.gg/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lumena.gg/*",
        "https://*.lumena.gg/*"
      ],
      "js": [
        "move-catalog.js",
        "world-catalog.js",
        "nav-catalog.js",
        "route-fix.js",
        "zone-catalog.js",
        "tier-catalog.js",
        "trainer-catalog.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
